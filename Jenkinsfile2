pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Framework Structure') {
            steps {
                powershell '''
                    $base = "Frameworks/ProjectSuiteTestFramework"

                    $required = @(
                        "$base/ProjectSuiteTestFramework.pjs",
                        "$base/TF1/TF1.mds",
                        "$base/TF1/Script/T01_UserRegistration.js",
                        "$base/TF1/Script/T02_Login.js",
                        "$base/TF1/Script/T03_Logout.js",
                        "$base/TF1/NameMapping/NameMapping.tcNM"
                    )

                    foreach ($file in $required) {
                        if (!(Test-Path $file)) {
                            throw "Missing required file: $file"
                        }
                        Write-Host "PASS: $file"
                    }
                '''
            }
        }

        stage('Validate JavaScript Syntax') {
            steps {
                powershell '''
                    $files = Get-ChildItem "Frameworks" -Recurse -Filter "*.js" |
                        Where-Object { $_.FullName -notmatch '[/\\\\]Visualizer[/\\\\]' }

                    if (-not $files) {
                        throw "No JavaScript files found."
                    }

                    foreach ($file in $files) {
                        Write-Host "Checking $($file.Name)"

                        node --check $file.FullName

                        if ($LASTEXITCODE -ne 0) {
                            throw "JavaScript syntax validation failed: $($file.Name)"
                        }

                        Write-Host "PASS: $($file.Name)"
                    }
                '''
            }
        }
    }
}